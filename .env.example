# SMARTSAVE Environment Configuration
# Copy this file to `.env` for local development
# On Render, set these as Environment Variables in the dashboard (or via render.yaml)

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database - Local (MySQL)
# On Render, use DATABASE_URL instead (auto-provisioned by Render)
DB_NAME=smartsave_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# OR - Database - Render (PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:port/smartsave_db

# Hosts & CORS
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://your-frontend-domain.com

# Render (auto-set by Render)
# RENDER_EXTERNAL_HOSTNAME=your-backend.onrender.com

# Production security (set to True only when DEBUG=False)
SECURE_SSL_REDIRECT=False